# Copy to .env.staging. Never commit actual credentials.
# Pin tested release tags or digests (do not use latest).
QDRANT_IMAGE=qdrant/qdrant:v1.18.0
OLLAMA_IMAGE=ollama/ollama:0.18.0
APP_ENV=staging
API_KEYS={"REPLACE_WITH_RANDOM_ADMIN_KEY_32_CHARS_MIN":{"tenant":"demo","role":"admin"},"REPLACE_WITH_RANDOM_READER_KEY_32_CHARS_MIN":{"tenant":"demo","role":"reader"}}
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
POSTGRES_ENABLED=false
POSTGRES_ALLOWED_TABLES=[]
MAX_UPLOAD_BYTES=26214400
MAX_CHUNKS=10000
EMBED_BATCH_SIZE=16
REQUEST_TIMEOUT=180
RATE_LIMIT_PER_MINUTE=60
# Workspace configuration and publishing setup: docs/WORKSPACE.md
AI_PROVIDER=ollama
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=
EMBEDDING_PROVIDER=ollama
AI_EMBEDDING_MODEL=
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=30
PUBLIC_BASE_URL=
MEDIA_SIGNING_KEY=
INSTAGRAM_API_VERSION=v25.0
PUBLISHING_CONNECTIONS={}
