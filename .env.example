APP_NAME=Local RAG MVP
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# Browser login is enabled by default. Local first login creates admin / admin123.
AUTH_ENABLED=true
# Optional initial password, used only when the admin account does not exist.
# Outside local mode, set this explicitly to initialize browser login; HTTPS is required.
AUTH_INITIAL_PASSWORD=

# Workspace text provider: ollama (existing default) or api (Chat Completions compatible).
# For the API prototype set AI_PROVIDER=api and fill AI_CHAT_MODEL + AI_API_KEY.
AI_PROVIDER=ollama
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=

# Command Code: AI_API_BASE_URL=https://api.commandcode.ai/provider/v1
# AI_CHAT_MODEL is the fallback; RAG, Social Media and campaigns can select models.

# Set api for an API-only prototype, or keep ollama for local embeddings.
# Changing embedding provider/model requires NEW storage + Qdrant collection and reindexing.
EMBEDDING_PROVIDER=ollama
AI_EMBEDDING_MODEL=

# Separate image generation provider, returning b64_json (e.g. a GPT Image model).
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=

# Single process/worker only. Scheduler publishes approved posts and activated campaigns.
# The tunnel launcher needs --enable-scheduler to run automatic campaigns.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=30
# Public HTTPS application URL, required for Instagram to fetch signed JPEG media.
PUBLIC_BASE_URL=
MEDIA_SIGNING_KEY=
INSTAGRAM_API_VERSION=v25.0
# Server-side credentials keyed by tenant (local for unauthenticated development).
# See docs/WORKSPACE.md. Never commit real tokens or application passwords.
PUBLISHING_CONNECTIONS={}

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=local_knowledge

RAG_SCORE_THRESHOLD=0.45

POSTGRES_ENABLED=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seamon-local-ipc-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_SCHEMA=public

OCR_ENABLED=true
OCR_LANG=eng+ind
OCR_DPI=200
OCR_MIN_TEXT_LENGTH=20
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_DIR=storage/tessdata
